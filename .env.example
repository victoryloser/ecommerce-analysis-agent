# Chat Completions 接口，模型需支持 JSON 输出。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# 网关支持该参数时可显式关闭思考模式；未配置则不发送此字段。
# LLM_ENABLE_THINKING=false
# 可选：各数据集交付目录的服务端根路径，默认 data/incoming。
# DATA_DELIVERY_DIR=

# 团队实例中允许发送给模型的数据。preview:<列名> 只允许所列结果列的最多三行。
# TEAM_MODEL_FIELDS=question,entities,scope
# 可选值 history 允许最近四条用户问题。移除 question 会关闭模型问答及 SQL 草稿。
# TEAM_REPORT_DAYS=90
# TEAM_DOWNLOAD_DAYS=7
# TEAM_LOG_DAYS=30
# 接入企业登录网关时，在实例私有配置中设置随机凭据 TEAM_PROXY_SECRET。
